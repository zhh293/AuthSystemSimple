# Local-only values. Replace every credential/key and enable Nacos authentication for shared environments.
SSO_HTTP_PORT=8080
SSO_DB_URL=jdbc:mysql://localhost:3306/sso?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SSO_DB_USERNAME=sso
SSO_DB_PASSWORD=sso-local-password
SSO_REDIS_HOST=localhost
SSO_REDIS_PORT=6379
SSO_REDIS_PASSWORD=
NACOS_ADDRESS=nacos://localhost:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
SSO_ISSUER=http://localhost:8080
SSO_IDENTITY_CREDENTIAL_MODE=database
SSO_DIRECTORY_SYNC_INTERVAL_MS=30000
SSO_DIRECTORY_SYNC_MAX_STALENESS_SECONDS=120
SSO_COOKIE_SECURE=false
SSO_SESSION_HMAC_KEY=local-development-only-change-this-key-before-use
SSO_RATE_LIMIT_HMAC_KEY=local-development-only-change-this-rate-key
SSO_OAUTH_STATE_HMAC_KEY=local-development-only-change-this-oauth-key
SSO_TOKEN_STORAGE_HMAC_KEY=local-development-only-change-this-token-key
SSO_TOKEN_STORAGE_HMAC_PREVIOUS_KEYS=
SSO_AUTH_STORAGE_ENCRYPTED=false
SSO_ADMIN_ACTOR=local-operator
SSO_OIDC_KEY_ALIAS=sso-signing
SSO_OIDC_PREVIOUS_KEY_ALIASES=
SSO_ID_TOKEN_TTL_SECONDS=600
